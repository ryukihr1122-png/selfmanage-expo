{
  "expo": {
    "name": "SelfManage",
    "slug": "selfmanage",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "selfmanage",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f0e8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ryukihara.selfmanage",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserTrackingUsageDescription": "広告の最適化とパーソナライズのために使用します",
        "CFBundleLocalizations": [
          "ja"
        ],
        "CFBundleDevelopmentRegion": "ja"
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f0e8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "package": "com.ryukihara.selfmanage",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c4870a"
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      "expo-asset",
      "expo-sqlite",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingUsageDescription": "広告の最適化とパーソナライズのために使用します"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3096e058-59ca-47bb-b78f-8228c39ac665"
      },
      "adMobTestMode": true,
      "router": {}
    },
    "updates": {
      "url": ""
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "ryukihhh"
  }
}
